// MIRROR — the deployed source of truth is `Admin Auth Screen/storage.rules`
// (only that project has a `.firebaserc`, so `firebase deploy` runs from
// there). Keep both files byte-identical below this header; edit the admin one
// first.
//
// Firebase Storage is retired in this project: proposal photos and meal photos
// go straight to Cloudinary, and no code path uploads here any more. The only
// remaining references to Firebase Storage are the vestigial instance injected
// into the admin panel's repository, which never uses it.
//
// Uploads are therefore closed unconditionally. The copy of this file that
// lives in the deploy source (`Admin Auth Screen/storage.rules`) used to grant
// `allow write: if request.auth != null` on /meal_images — and since the mobile
// app signs in anonymously the moment a meal is proposed, that rule let any
// device on any network write unlimited, arbitrary-type objects into the
// bucket.
//
// Reads stay open: meals and pending proposals seeded before the Cloudinary
// move may still carry /meal_images or /staging_meal_images URLs, and locking
// reads would blank their photos rather than protect anything.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /meal_images/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /staging_meal_images/{uid}/{fileName} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
