rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /meal_images/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Staging proposal photos: an authenticated user may upload ONLY inside
    // their own uid folder, capped at 500KB (mirrors the client-side gate in
    // lib/features/vault/application/meal_proposal_service.dart). Admins
    // promote the approved shot into /meal_images later.
    match /staging_meal_images/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 500 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
